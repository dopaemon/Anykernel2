#!/sbin/sh
# Ubuntu Touch Flashable Zip
# Base Flashable Zip With Erfan
# Create Flashable Zip With Dopaemon
# Based on anykernel2 script by osm0sis

OUTFD=/proc/self/fd/$2;
ZIP="$3";
DIR=`dirname "$ZIP"`;

ui_print() {
  until [ ! "$1" ]; do
    echo -e "ui_print $1\nui_print" > $OUTFD;
    shift;
  done;
}
show_progress() { echo "progress $1 $2" > $OUTFD; }
find_slot() {
  local slot=$(getprop ro.boot.slot_suffix 2>/dev/null);
  [ "$slot" ] || slot=$($bb grep -o 'androidboot.slot_suffix=.*$' /proc/cmdline | $bb cut -d\  -f1 | $bb cut -d= -f2);
  if [ ! "$slot" ]; then
    slot=$(getprop ro.boot.slot 2>/dev/null);
    [ "$slot" ] || slot=$($bb grep -o 'androidboot.slot=.*$' /proc/cmdline | $bb cut -d\  -f1 | $bb cut -d= -f2);
    [ "$slot" ] && slot=_$slot;
  fi;
  [ "$slot" ] && echo "$slot";
}
set_perm_recursive() {
  dirs=$(echo $* | $bb awk '{ print substr($0, index($0,$5)) }');
  for i in $dirs; do
    chown -R $1.$2 $i; chown -R $1:$2 $i;
    find "$i" -type d -exec chmod $3 {} +;
    find "$i" -type f -exec chmod $4 {} +;
  done;
}
abort() { ui_print "$*"; umount /vendor; umount /data; exit 1; }

show_progress 1.34 4;
ui_print " ";
ui_print " ----------------------------- ";
ui_print "       Doraemon Kernel ";
ui_print " ----------------------------- ";
ui_print " Device: Xiaomi ";
ui_print " Linux: 5.10.y - GKI ";
ui_print " Android: 12 ";
ui_print " Developer: @KernelPanix ";
ui_print " ----------------------------- ";
ui_print " ----------------------------- ";
mount -o ro /vendor_boot;
mount -o ro / vendor_dlkm;
mount -o ro /vendor;
mount /data;

mkdir -p /data/dora/bin;
cd /data/dora;
ui_print " Extracting Zip Into /data ";
unzip -o "$ZIP";
if [ $? != 0 -o -z "$(ls /data/dora/tools)" ]; then
  abort "Unzip failed. Aborting...";
fi;
chmod -R 755 /data/dora/tools /data/dora/bin;
bb=/data/dora/tools/busybox;

for i in $($bb --list); do
  $bb ln -s $bb /data/dora/bin/$i;
done;
if [ $? != 0 -o -z "$(ls /data/dora/bin)" ]; then
  abort "Recovery busybox setup failed. Aborting...";
fi;
SLOT=$(find_slot) PATH="/data/dora/bin:$PATH" $bb ash /data/dora/dora.sh $2;
if [ $? != "0" ]; then
  abort;
fi;

umount /vendor;
umount /data;
ui_print " ";
ui_print "Install Done Thanks You Install DoraCore Kernel.";
